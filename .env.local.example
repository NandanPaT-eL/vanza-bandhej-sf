# Copy this file to .env.local and fill in your Shopify Headless channel
# credentials (Settings > Sales channels > Headless > your storefront).
#
# Never commit .env.local — it's already in .gitignore.

# e.g. 8mgrmc-sc.myshopify.com (no https://, no trailing slash)
SHOPIFY_STORE_DOMAIN=

# The PRIVATE access token from the Headless channel's Storefront API
# card. Server-side only — never expose this in client components.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
